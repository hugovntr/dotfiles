					],
					"from": { "key_code": "b" },
					"to": [{ "key_code": "9", "modifiers": ["left_shift"] }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "n" },
					"to": [{ "key_code": "comma" }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "m" },
					"to": [{ "key_code": "semicolon", "modifiers": ["left_shift"] }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "comma" },
					"to": [{ "key_code": "8" }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "period" },
					"to": [{ "key_code": "equal_sign", "modifiers": ["left_shift"] }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "slash" },
					"to": [
						{ "key_code": "l", "modifiers": ["left_shift", "left_option"] }
					]
				}
			]
		}
	]
}
