{
	"title": "QMK Emulation",
	"rules": [
		{
			"description": "QMK Emulation: Home Row Mods + Tri-Layer (Lower/Raise)",
			"manipulators": [
				{
					"description": "Left Command -> Lower Layer (Variable)",
					"type": "basic",
					"from": {
						"key_code": "left_command",
						"modifiers": { "optional": ["any"] }
					},
					"to": [{ "set_variable": { "name": "layer_lower", "value": 1 } }],
					"to_after_key_up": [
						{ "set_variable": { "name": "layer_lower", "value": 0 } }
					]
				},
				{
					"description": "Right Command -> Raise Layer (Variable)",
					"type": "basic",
					"from": {
						"key_code": "right_command",
						"modifiers": { "optional": ["any"] }
					},
					"to": [{ "set_variable": { "name": "layer_raise", "value": 1 } }],
					"to_after_key_up": [
						{ "set_variable": { "name": "layer_raise", "value": 0 } }
					]
				},
				{
					"description": "Left Control -> Left Option",
					"type": "basic",
					"from": {
						"key_code": "left_control",
						"modifiers": { "optional": ["any"] }
					},
					"to": { "key_code": "left_option" }
				},
				{
					"description": "Left Option -> Left Command",
					"type": "basic",
					"from": {
						"key_code": "left_option",
						"modifiers": { "optional": ["any"] }
					},
					"to": { "key_code": "left_command" }
				},
				{
					"description": "Right Option -> Right Command",
					"type": "basic",
					"from": {
						"key_code": "right_option",
						"modifiers": { "optional": ["any"] }
					},
					"to": { "key_code": "right_command" }
				},

				{
					"description": "Adjust Layer: Reset/Macros (Example)",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 },
						{ "type": "variable_if", "name": "layer_raise", "value": 1 }
					],
					"type": "basic",
					"from": { "key_code": "delete_or_backspace" },
					"to": [{ "key_code": "delete_forward" }]
				},

				{
					"description": "Caps Lock -> Control (Hold) / Escape (Tap)",
					"type": "basic",
					"from": {
						"key_code": "caps_lock",
						"modifiers": { "optional": ["any"] }
					},
					"to": [{ "key_code": "left_control" }],
					"to_if_alone": [{ "key_code": "escape" }]
				},
				{
					"description": "S -> Shift (Hold) / S (Tap)",
					"type": "basic",
					"from": { "key_code": "s" },
					"to": [{ "key_code": "left_shift" }],
					"to_if_alone": [{ "key_code": "s" }],
					"to_if_held_down_threshold_milliseconds": 200
				},
				{
					"description": "D -> Command (Hold) / D (Tap)",
					"type": "basic",
					"from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
					"to": [{ "key_code": "left_command" }],
					"to_if_alone": [{ "key_code": "d" }],
					"to_if_held_down_threshold_milliseconds": 200
				},
				{
					"description": "H -> Right Option (Hold) / H (Tap)",
					"type": "basic",
					"from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
					"to": [{ "key_code": "right_option" }],
					"to_if_alone": [{ "key_code": "h" }],
					"to_if_held_down_threshold_milliseconds": 200
				},
				{
					"description": "J -> Shift (Hold) / J (Tap)",
					"type": "basic",
					"from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
					"to": [{ "key_code": "right_shift" }],
					"to_if_alone": [{ "key_code": "j" }],
					"to_if_held_down_threshold_milliseconds": 200
				}
			]
		},
		{
			"description": "QMK Raise Layer (Navigation)",
			"manipulators": [
				{
					"description": "Raise Layer: J -> Left",
					"conditions": [
						{ "type": "variable_if", "name": "layer_raise", "value": 1 }
					],
					"type": "basic",
					"from": { "key_code": "j" },
					"to": [{ "key_code": "left_arrow" }]
				},
				{
					"description": "Raise Layer: K -> Up",
					"conditions": [
						{ "type": "variable_if", "name": "layer_raise", "value": 1 }
					],
					"type": "basic",
					"from": { "key_code": "k" },
					"to": [{ "key_code": "up_arrow" }]
				},
				{
					"description": "Raise Layer: L -> Down",
					"conditions": [
						{ "type": "variable_if", "name": "layer_raise", "value": 1 }
					],
					"type": "basic",
					"from": { "key_code": "l" },
					"to": [{ "key_code": "down_arrow" }]
				},
				{
					"description": "Raise Layer: M -> Right",
					"conditions": [
						{ "type": "variable_if", "name": "layer_raise", "value": 1 }
					],
					"type": "basic",
					"from": { "key_code": "semicolon" },
					"to": [{ "key_code": "right_arrow" }]
				}
			]
		},
		{
