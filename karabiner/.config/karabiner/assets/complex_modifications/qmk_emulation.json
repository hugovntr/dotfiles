						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
					],
					"from": { "key_code": "u" },
					"to": [{ "key_code": "6", "modifiers": ["left_shift"] }]
				},
				{
					"type": "basic",
					"conditions": [
						{ "type": "variable_if", "name": "layer_lower", "value": 1 }
