{
  "title": "Home Row Mods",
  "rules": [
    {
      "description": "A(Q) -> Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "a" },
          "to": { "key_code": "a" },
          "conditions": [
            { "type": "variable_if", "name": "a_pressed", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "a" },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200,
            "basic.to_if_held_down_threshold_milliseconds": 200
          },
          "to_if_alone": [
            { "set_variable": { "name": "a_pressed", "value": 1 } },
            { "key_code": "a" }
          ],
          "to_if_held_down": { "key_code": "left_shift"},
          "to_delayed_action": {
            "to_if_invoked": { "set_variable": {"name": "a_pressed", "value": 0 }},
            "to_if_canceled": { "set_variable": {"name": "a_pressed", "value": 0 }}
          }
        }
      ]
    },
    {
      "description": "C-s -> Ctrl + Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["left_control"]
            }
          },
          "to": {
            "key_code": "left_shift",
            "modifiers": [
              "left_control"
            ]
          }
        }
      ]
    },
    {
      "description": "[Code Fast] RShift + QSD = ({[",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "5"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "5",
            "modifiers": ["right_option"]
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "5",
            "modifiers": ["right_option", "left_shift"]
          }
        }
      ]
    },
    {
      "description": "[Code Fast] RShift + FGH = )}]",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "hyphen"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "g",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "hyphen",
            "modifiers": ["right_option"]
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": ["right_shift"]
            }
          },
          "to": {
            "key_code": "hyphen",
            "modifiers": ["right_option", "left_shift"]
          }
        }
      ]
    }
  ]
}
