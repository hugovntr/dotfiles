{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "lucent-orng",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "verbosity": "medium"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true
  },
  "keybinds": {
    "leader": "ctrl+o",
    "session.tab.previous": "<leader>p",
    "session.tab.next": "<leader>n",
    "session.half.page.up": "ctrl+b",
    "session.half.page.down": "ctrl+f",
    "session.background": "<leader>b"
  }
}
