shell-integration = zsh
command = ~/.config/ghostty/command.sh
confirm-close-surface = false
title = "Ghostty"

# Theme
theme = "catppuccin-mocha"
background = #010309
foreground = #fff
cursor-color = "#fff"
cursor-text = "#09090b"
selection-background = "#3c4048"
selection-foreground = "#fff"
palette = 0=#6b7280
palette = 1=#ff6e5e
palette = 2=#5eff6c
palette = 3=#f1ff5e
palette = 4=#5ea1ff
palette = 5=#bd5eff
palette = 6=#5ef1ff
palette = 7=#ffffff
# palette = 8=#16181a
palette = 8=#6b7280
palette = 9=#ff6e5e
palette = 10=#5eff6c
palette = 11=#f1ff5e
palette = 12=#5ea1ff
palette = 13=#bd5eff
palette = 14=#5ef1ff
palette = 15=#ffffff

# Window style
macos-titlebar-style = "hidden"
alpha-blending = "linear-corrected"
background-opacity = .9
background-blur-radius = 48
window-padding-x = 8,2
window-padding-y = 0
window-padding-balance = true
window-vsync = true
window-colorspace = "display-p3"
window-decoration = "none"

# MacOS window style
macos-window-shadow = false
macos-icon = "holographic"

# Font
font-family = "JetBrains Mono"
font-feature = "calt, liga, zero, cv12, ss20, cv10, cv16, cv18"
font-thicken = false
font-thicken-strength = 10
font-size = 12
adjust-cell-height = "75%"
#adjust-cell-width = "-7%"
adjust-cell-width = "-7%"
adjust-cursor-height = "75%"

# Keybind
macos-option-as-alt = left
# keybind = cmd+s=text:\x1b:w\n
keybind = cmd+s=text:\x1bs
keybind = cmd+r=reload_config
keybind = cmd+k=text:\x07

# Tmux Navigation
keybind = ctrl+m=text:\x08
