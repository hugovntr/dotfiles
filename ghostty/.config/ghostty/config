shell-integration = fish
command = shell:~/.config/ghostty/command.sh
confirm-close-surface = false
title = "Ghostty"

# Theme
theme = light:forest-light,dark:forest-night

# Window style
alpha-blending = "native"
window-padding-x = 8,2
window-padding-y = 0
window-padding-balance = "true"
window-vsync = true
#window-padding-color = "extend-always"
window-padding-color = "extend"
window-colorspace = "display-p3"

# MacOS window style
macos-titlebar-style = "hidden"
macos-window-shadow = false
macos-icon = "holographic"

# Font
font-family = "Geist Mono"
font-feature = "calt, liga, zero, cv12, ss20, cv10, cv16, cv18"
font-thicken = false
font-size = 12
adjust-cell-height = "75%"
adjust-cell-width = "-7%"
adjust-cursor-height = "75%"

# Keybind
macos-option-as-alt = left
# keybind = cmd+s=text:\x1b:w\n
keybind = cmd+s=text:\x1bs
keybind = cmd+r=reload_config
keybind = cmd+k=text:\x07

# Tmux Navigation
keybind = ctrl+m=text:\x08

# Custom Shader
#custom-shader = ~/.config/ghostty/shaders/glitchy.glsl
#custom-shader-animation = "always"
