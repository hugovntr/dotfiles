    <key>Label</key>
    <string>com.hugo.omniwm</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/hugo/bin:/Users/hugo/.local/bin</string>
